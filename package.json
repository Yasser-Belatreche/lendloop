{
  "name": "lendloop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:convex": "convex dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "n8n:up": "docker compose up -d n8n",
    "n8n:import": "docker compose stop n8n && docker compose run --rm --entrypoint n8n n8n import:workflow --separate --input=/workflows && docker compose up -d n8n"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.25",
    "convex": "^1.49.0",
    "next": "^16.4.5",
    "react": "~19.2.3",
    "react-dom": "~19.2.3"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "convex-test": "^0.0.67",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
