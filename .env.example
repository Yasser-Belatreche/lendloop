# ---------- Next.js (.env.local) ----------
# Written by `npx convex dev` on first run
NEXT_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud
# Clerk dashboard -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ---------- Convex (set with `npx convex env set NAME value`, never in this file) ----------
# CLERK_JWT_ISSUER_DOMAIN   Clerk Frontend API URL, e.g. https://<slug>.clerk.accounts.dev
# ADMIN_EMAILS              comma-separated, verified emails that become admin on first sign-in
# N8N_REQUEST_WEBHOOK_URL   n8n production webhook URL of "LendLoop - Request notification"
# LENDLOOP_WEBHOOK_SECRET   shared HMAC secret (same value in n8n), e.g. `openssl rand -hex 32`

# ---------- n8n (docker compose reads these from .env next to docker-compose.yml) ----------
# LENDLOOP_WEBHOOK_SECRET=<same value as in Convex>
# CONVEX_SITE_URL=https://<your-deployment>.convex.site
# N8N_ENCRYPTION_KEY=<random, keeps n8n credentials encrypted at rest>
